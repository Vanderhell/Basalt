<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PackageId>Basalt</PackageId>
    <Version>1.0.0-rc.1</Version>
    <Authors>Vanderhell</Authors>
    <Description>Local durable background jobs, scheduling and workflow engine for .NET applications.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>jobs;durable;background;WPF;scheduling;workflow</PackageTags>
    <RepositoryUrl>https://github.com/Vanderhell/Basalt</RepositoryUrl>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\BasaltCore.Native\BasaltCore.Native.csproj" />
    <PackageReference Include="System.Memory" Version="4.5.5" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="..\build-release\Release\basalt_core_shared.dll" Condition="Exists('..\build-release\Release\basalt_core_shared.dll')" Pack="true" PackagePath="runtimes\win-x64\native" />
  </ItemGroup>
</Project>
